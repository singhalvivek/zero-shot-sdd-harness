# AI CAD Studio — environment

# SQLite database (created by `uv run alembic upgrade head`)
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# --- LLM provider: Google Gemini (required) ---
# The app calls the Gemini Developer API via `genai.Client(api_key=...)`.
# Get a key at https://aistudio.google.com/apikey  (Developer API keys start with "AIza").
# This is the ONE required secret. Tests and the build run against the REAL Gemini API.
AGENT_GEMINI_API_KEY=

# Provider is auto-detected from the key above; the model is chosen per-request in the UI
# (gemini-3.5-flash = higher quality [default] / gemini-3.1-flash-lite = fastest). Leave these unset unless overriding.
# AGENT_LLM_PROVIDER=gemini
# AGENT_LLM_MODEL=

# --- CAD sandbox tuning (optional; sensible defaults in settings) ---
# AGENT_EXEC_TIMEOUT_SECONDS=20
# AGENT_MAX_REPAIR_ATTEMPTS=3

# --- Optional LangSmith tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
